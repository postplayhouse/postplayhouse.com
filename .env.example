# Duplicate this file, removing the `-example` extension to work locally. For
# production, ensure that the following ENV vars are available on the server for
# server functions and at build time for all the static files that need them. 
#
# In Netlify, this is all one place:
# https://app.netlify.com/sites/postplayhouse-main-site/configuration/env

# Existing bucket identifier and bio-submission credentials. The cache publisher
# reuses only the bucket ID, never the general application credentials.
B2_BUCKET_ID=SOME_ID
B2_APPLICATION_KEY_ID=SOME_ID
B2_APPLICATION_KEY=SOME_KEY

# Portable enhanced-image cache. Read credentials belong in ordinary build and
# Orb environments; write credentials belong only in trusted publisher contexts.
B2_CACHE_READ_APPLICATION_KEY_ID=SOME_READ_ONLY_ID
B2_CACHE_READ_APPLICATION_KEY=SOME_READ_ONLY_KEY
B2_CACHE_WRITE_APPLICATION_KEY_ID=SOME_WRITE_ID
B2_CACHE_WRITE_APPLICATION_KEY=SOME_WRITE_KEY

GITHUB_ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxx
BASECAMP_BIO_BOT_INTEGRATION_KEY=xxxxxxxxxxxxx

# For auto-adding to BC projects per year
BASECAMP_TOKEN=your_oauth_access_token_here
BASECAMP_CALL_BOARD_PROJECT=Virtual Call Board 2026
BASECAMP_PRODUCTION_PROJECT=Production Staff 2026
NETLIFY_WEBHOOK_SECRET=xxxxxxxxxxxxx

# Need new phrases for a new year? `pnpm gen:phrases`
INDIVIDUAL_PASSPHRASES_LIST=some-phrase,another-phrase,etc-more

# The SENTRY_AUTH_TOKEN variable is picked up by the Sentry Build Plugin.
# It's used for authentication when uploading source maps.
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxx
