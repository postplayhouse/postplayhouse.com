# Optional plaintext fallback for local development. Prefer the 1Password
# workflow in docs/environment-variables.md. Never put real values in this file.
# Copy to .env (git-ignored), replace only what your command needs, then validate
# with `pnpm env:check`. The authoritative contract is .env.schema.

# Application runtime and B2 bio tooling
B2_BUCKET_ID=replace-with-b2-bucket-id
B2_APPLICATION_KEY_ID=replace-with-b2-key-id
B2_APPLICATION_KEY=replace-with-b2-application-key

# Historical responsive-image archive read access for ordinary local, Orb, PR,
# and Netlify builds. This key must have readFiles only for the dedicated bucket.
B2_HISTORICAL_IMAGES_BUCKET_NAME=replace-with-dedicated-bucket-name
B2_HISTORICAL_IMAGES_READ_APPLICATION_KEY_ID=replace-with-read-only-key-id
B2_HISTORICAL_IMAGES_READ_APPLICATION_KEY=replace-with-read-only-application-key
GITHUB_ACCESS_TOKEN=replace-with-github-server-token
BASECAMP_BIO_BOT_INTEGRATION_KEY=replace-with-basecamp-integration-key
NETLIFY_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Local Basecamp people-management tooling. The project names are public config;
# update their year each season. BASECAMP_TOKEN is an OAuth credential with write access.
BASECAMP_TOKEN=replace-with-basecamp-oauth-token
BASECAMP_CALL_BOARD_PROJECT=Virtual Call Board 2026
BASECAMP_PRODUCTION_PROJECT=Production Staff 2026

# Need new phrases for a new year? Run `pnpm gen:phrases`, then store the ordered
# comma-separated result here or in 1Password.
INDIVIDUAL_PASSPHRASES_LIST=first-placeholder,second-placeholder

# Optional: Sentry source-map uploads and gh CLI bio-email collection.
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
GITHUB_TOKEN=replace-with-gh-cli-token

# Netlify supplies CONTEXT, DEPLOY_PRIME_URL, NODE_VERSION, and NODE_ENV. env.js
# derives PUBLIC_BUILD_URL. Do not set those locally unless testing that behavior.
