# Post Playhouse environment contract. Secret values belong in a local ignored
# .env file, a deployment provider, Amp project secrets, or 1Password.
# @defaultRequired=false
# @defaultSensitive=true
# @currentEnv=$VARLOCK_ENV
# ---

# --- Platform-provided build and deploy context (public) ---

# Varlock validation profile. Package scripts select production only for deploys.
# @public @required @type=enum(development, production, test) @tag(platform, tooling)
VARLOCK_ENV=development

# 1Password service-account secret zero. Used only by the optional
# .env.1password entry point; Varlock never injects it into child commands.
# @auditIgnore @optional @sensitive @internal @type=string(startsWith=ops_)
# @tag(private, tooling, onepassword)
OP_SERVICE_ACCOUNT_TOKEN=

# Node/Vite execution mode. Usually supplied by the tool rather than a developer.
# @public @type=enum(development, production, test) @tag(platform, build)
NODE_ENV=

# Netlify deploy context.
# @public @type=enum(production, deploy-preview, branch-deploy, dev) @tag(platform, deploy)
CONTEXT=

# Netlify's canonical URL for a deploy preview or branch deploy.
# @public @type=url @tag(platform, build, deploy)
DEPLOY_PRIME_URL=

# Set by env.js from NODE_ENV, CONTEXT, and DEPLOY_PRIME_URL for SvelteKit.
# @public @type=url @tag(public, build, runtime)
PUBLIC_BUILD_URL=

# Pinned independently in .tool-versions and netlify.toml; Netlify consumes it.
# @auditIgnore @public @type=string(matches=/^v?24\./) @tag(platform, deploy)
NODE_VERSION=

# --- Application runtime secrets ---

# Production Backblaze B2 bucket for bio runtime/tooling and historical-image
# restore/publication. Credentials remain shared even though bio writes use a
# separate bucket outside production.
# @auditIgnore
# @optional @sensitive @type=string(minLength=10)
# @tag(private, runtime, build, deploy, tooling, bio, historical-images, b2)
B2_BUCKET_ID=

# Production B2 bucket name, needed to construct download and public URLs.
# @optional @sensitive @type=string(minLength=3)
# @tag(private, runtime, deploy, bio, b2)
B2_BUCKET_NAME=

# Shared Backblaze B2 application-key identifier.
# @optional @sensitive @type=string(minLength=10)
# @tag(private, runtime, build, deploy, tooling, bio, historical-images, b2)
B2_APPLICATION_KEY_ID=

# Shared Backblaze B2 application key. Operation-level code paths and object
# prefixes isolate behavior, but the credential itself may authorize every use.
# @optional @sensitive @type=string(minLength=20)
# @tag(private, runtime, build, deploy, tooling, bio, historical-images, b2)
B2_APPLICATION_KEY=

# Isolated non-production B2 bucket used by local development and tests.
# @optional @sensitive @type=string(minLength=3)
# @tag(private, runtime, tooling, test, bio, b2)
B2_TEST_BUCKET_ID=

# @optional @sensitive @type=string(minLength=3)
# @tag(private, runtime, tooling, test, bio, b2)
B2_TEST_BUCKET_NAME=

# Local filesystem artifact-store fixture. Testing only; never configure in
# Netlify or a production build.
# @auditIgnore @optional @public @type=string(minLength=1)
# @tag(tooling, test, historical-images)
HISTORICAL_IMAGES_STORE_DIR=

# GitHub token used by the bio-submission server routes to create branches/PRs.
# @auditIgnore
# @required=forEnv(production) @sensitive @type=string(minLength=20)
# @tag(private, runtime, deploy, github)
GITHUB_ACCESS_TOKEN=

# Basecamp integration key used for bio and deploy notifications.
# @auditIgnore
# @required=forEnv(production) @sensitive @type=string(minLength=10)
# @tag(private, runtime, deploy, basecamp)
BASECAMP_BIO_BOT_INTEGRATION_KEY=

# Basecamp OAuth bearer token for local people/project management. This can add
# existing users and invite new users, so never expose it to untrusted automation.
# @auditIgnore @optional @sensitive @type=string(minLength=20)
# @tag(private, tooling, bio, basecamp, write)
BASECAMP_TOKEN=

# Current-season Basecamp project names used only by bio:basecamp.
# @auditIgnore @optional @public @type=string(minLength=3)
# @tag(public, tooling, bio, basecamp)
BASECAMP_CALL_BOARD_PROJECT="Virtual Call Board 2026"

# @auditIgnore @optional @public @type=string(minLength=3)
# @tag(public, tooling, bio, basecamp)
BASECAMP_PRODUCTION_PROJECT="Production Staff 2026"

# HS256 secret configured on the matching Netlify deploy webhook. jsonwebtoken
# requires only a non-empty HMAC secret. This intentionally modest validator
# preserves the externally coordinated existing secret; do not rotate it merely
# to satisfy a stronger schema rule.
# @auditIgnore
# @required=forEnv(production) @sensitive @type=string(minLength=1)
# @tag(private, runtime, deploy, webhook)
NETLIFY_WEBHOOK_SECRET=

# Production cache-purge credentials used after bio approval.
# @auditIgnore @optional @sensitive @type=string(minLength=10)
# @tag(private, runtime, deploy, bio, netlify)
NETLIFY_API_TOKEN=

# @auditIgnore @optional @sensitive @type=string(minLength=3)
# @tag(private, runtime, deploy, bio, netlify)
NETLIFY_SITE_ID=

# Ordered, comma-separated bio-submission passphrases; order determines position.
# @auditIgnore
# @required=forEnv(production) @sensitive @type=string(minLength=3)
# @tag(private, runtime, deploy, passphrase)
INDIVIDUAL_PASSPHRASES_LIST=

# Comma-separated passphrase positions authorized to approve submitted bios.
# @auditIgnore
# @required=forEnv(production) @sensitive @type=string(matches=/^\d+(,\d+)*$/)
# @tag(private, runtime, deploy, passphrase, admin)
ADMIN_PASSPHRASE_POSITIONS=

# Sentry source-map upload token. Builds still work without source-map upload.
# @auditIgnore @optional @sensitive @type=string(minLength=20)
# @tag(private, build, deploy, sentry)
SENTRY_AUTH_TOKEN=

# --- Local tooling inputs and inherited control variables ---

# Optional token recognized by gh CLI during bio email collection. This is not
# an alias for GITHUB_ACCESS_TOKEN in code; gh CLI login may be used instead.
# @auditIgnore @optional @sensitive @type=string(minLength=20)
# @tag(private, tooling, bio, github)
GITHUB_TOKEN=

# Set by Claude Code; bio tooling removes it only from the nested claude process.
# @auditIgnore @optional @public @tag(tooling, bio)
CLAUDECODE=

# Set internally for date-preserving bio-tool commits, not user configuration.
# @auditIgnore @optional @public @type=isoDate @tag(tooling, bio)
GIT_AUTHOR_DATE=

# Set internally for date-preserving bio-tool commits, not user configuration.
# @auditIgnore @optional @public @type=isoDate @tag(tooling, bio)
GIT_COMMITTER_DATE=

# dotenv diagnostic control retained by the B2 audit command.
# @auditIgnore @optional @public @type=boolean @tag(tooling, bio)
DOTENV_CONFIG_QUIET=

# Set internally by Playwright to isolate external-service behavior.
# @auditIgnore @optional @public @type=boolean @tag(tooling, test)
PLAYWRIGHT_TEST=
